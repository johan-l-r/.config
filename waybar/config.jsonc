{
	"layer": "top", 
	"position": "top",
	"margin": "10 10 0 10", 

	"modules-left": [
		"hyprland/workspaces", 
		"hyprland/window", 
	], 
	"modules-center": [ 
		"clock" 
	], 
	"modules-right": [
		"custom/power"
	], 

	"clock": {
    "locale": "en_US.UTF-8",
		"format": "  {:L%H %M    %d %m %Y} "
	},

	"hyprland/window": {
		"format": "{class}", 
		"tooltip-format": "{title}", 
	}, 
	"hyprland/workspaces": {
		"format": "{name}{windows}", 
		"window-rewrite": {
			"class<steam>": "", 
			"class<firefox>": "", 
			"class<kitty>": ""
		}
	}, 

	"custom/power": {
		"format": "", 
		"on-click": "~/.config/scripts/power.sh",
		"tooltip": false
	}
}
